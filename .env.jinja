# ==============================================================================
# {{ project_name }} — Environment Configuration (Auto-Generated by Copier)
# ==============================================================================

# ── Runtime & Security ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME={{ project_slug }}
ENVIRONMENT=development
DEBUG=True
APP_NAME="{{ project_name }}"
SECRET_KEY="{{ secret_key }}"
APP_HOST=0.0.0.0
APP_PORT={{ app_port }}
APP_BASE_URL=http://localhost:{{ app_port }}

# ── Database Infrastructure (PostgreSQL 16 / TimescaleDB) ──────────────────────
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD="{{ postgres_password }}"
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=postgres-db
POSTGRES_PORT={{ postgres_port }}
{% if include_pgbouncer %}
# In container mesh: route standard queries through PgBouncer (6432)
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@pgbouncer:6432/{{ postgres_db }}
# Stateful direct connection bypassing PgBouncer (required for LISTEN/NOTIFY & migrations)
DIRECT_DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@postgres-db:5432/{{ postgres_db }}
{% else %}
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@postgres-db:{{ postgres_port }}/{{ postgres_db }}
DIRECT_DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@postgres-db:{{ postgres_port }}/{{ postgres_db }}
{% endif %}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache Engine (Valkey) ─────────────────────────────────────────────────────
{% if include_valkey %}
VALKEY_HOST=valkey-cache
VALKEY_PORT=6379
{% endif %}

# ── Initial Platform Superuser ────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL={{ first_superuser_email }}
FIRST_SUPERUSER_PASSWORD="{{ first_superuser_password | trim('\"\'') }}"
FIRST_SUPERUSER_NAME="{{ author_name | trim('\"\'') }}"

# ── API Documentation & Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED={{ "true" if include_rate_limiting else "false" }}
DOCS_UI={{ docs_ui }}

# ── Sentry Observability (APM & Error Tracking) ────────────────────────────────
{% if include_sentry and sentry_dsn %}
SENTRY_DSN={{ sentry_dsn }}
{% else %}
SENTRY_DSN=
{% endif %}
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Cloudflare Zero Trust Edge Tunnel ─────────────────────────────────────────
{% if include_cloudflare_tunnel %}
CLOUDFLARED_TUNNEL_TOKEN=
{% endif %}

# ── SMTP Email Dispatch (Optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_ADDRESS=noreply@platform.internal
EMAILS_FROM_NAME="{{ project_name }}"
