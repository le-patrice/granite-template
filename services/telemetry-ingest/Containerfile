# Stage 1: Build static standalone binary
FROM docker.io/library/golang:1.24-alpine AS builder

WORKDIR /build

# Cache Go modules first before copying entire source code
COPY go.mod go.sum* ./
RUN go mod download

# Copy source code and compile statically
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o telemetry-ingest .

# Stage 2: Minimal Distroless runtime image (~18MB total)
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app
COPY --from=builder /build/telemetry-ingest /app/telemetry-ingest

EXPOSE 8001
USER nonroot:nonroot

ENTRYPOINT ["/app/telemetry-ingest"]
