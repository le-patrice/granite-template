# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="{{ project_name }}"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
APP_HOST=0.0.0.0
APP_PORT={{ app_port }}

# Database Infrastructure (TimescaleDB / PostgreSQL)
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=postgres-db
POSTGRES_PORT={{ postgres_port }}
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:change_this_to_a_secure_postgres_password@postgres-db:{{ postgres_port }}/{{ postgres_db }}

# Cache Engine (Valkey)
{% if include_valkey %}
VALKEY_HOST=valkey-cache
VALKEY_PORT=6379
{% endif %}

# Initial Superuser Account
FIRST_SUPERUSER_EMAIL={{ first_superuser_email }}
FIRST_SUPERUSER_PASSWORD="ChangeMeImmediately123!"
FIRST_SUPERUSER_NAME="{{ author_name }}"

# Cloudflare Zero Trust Tunnel
CLOUDFLARED_TUNNEL_TOKEN=
