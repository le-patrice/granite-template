# ==============================================================================
# {{ project_name }} — Environment Example Template
# ==============================================================================

# ── Runtime & Security ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME={{ project_slug }}
ENVIRONMENT=development
DEBUG=True
APP_NAME="{{ project_name }}"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
APP_HOST=0.0.0.0
APP_PORT={{ app_port }}
APP_BASE_URL=http://localhost:{{ app_port }}

# ── Database Infrastructure (PostgreSQL 16 / TimescaleDB) ──────────────────────
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=postgres-db
POSTGRES_PORT={{ postgres_port }}
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:change_this_to_a_secure_postgres_password@postgres-db:{{ postgres_port }}/{{ postgres_db }}
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache Engine (Valkey) ─────────────────────────────────────────────────────
{% if include_valkey %}
VALKEY_HOST=valkey-cache
VALKEY_PORT=6379
{% endif %}

# ── Initial Platform Superuser ────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL={{ first_superuser_email }}
FIRST_SUPERUSER_PASSWORD="{{ first_superuser_password }}"
FIRST_SUPERUSER_NAME="{{ author_name }}"

# ── API Documentation & Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED={{ "true" if include_rate_limiting else "false" }}
DOCS_UI={{ docs_ui }}

# ── Sentry Observability (APM & Error Tracking) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Cloudflare Zero Trust Edge Tunnel ─────────────────────────────────────────
{% if include_cloudflare_tunnel %}
CLOUDFLARED_TUNNEL_TOKEN=
{% endif %}

# ── SMTP Email Dispatch (Optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_ADDRESS=noreply@platform.internal
EMAILS_FROM_NAME="{{ project_name }}"
