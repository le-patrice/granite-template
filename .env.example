# ── Application Runtime ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
APP_NAME="Enterprise Platform"
APP_BASE_URL=http://localhost:8000
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database (PostgreSQL / TimescaleDB) ──────────────────────────────────────
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_DB=app_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app_user:secure_dev_password@localhost:5432/app_db

# ── Connection Pool (PgBouncer / HA tuning) ──────────────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache & Message Broker (Valkey) ──────────────────────────────────────────
VALKEY_HOST=localhost
VALKEY_PORT=6379

# ── Token Expiry ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=60
VERIFY_TOKEN_EXPIRE_MINUTES=1440

# ── SMTP / Transactional Email ────────────────────────────────────────────────
# Leave SMTP_HOST blank to enable structlog mock mode (no real emails sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_ADDRESS=noreply@platform.internal
EMAILS_FROM_NAME="Enterprise Platform"

# ── Initial Superuser Seeding ─────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@platform.internal
FIRST_SUPERUSER_PASSWORD=ChangeMeImmediately123!
FIRST_SUPERUSER_NAME="Platform Administrator"

# ── Cloudflare Zero Trust Tunnel ──────────────────────────────────────────────
CLOUDFLARED_TUNNEL_TOKEN=
