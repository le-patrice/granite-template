# Environment & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=default_secret_key_override_in_env
APP_NAME=Enterprise Platform
APP_BASE_URL=http://localhost:8000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://app_user:secure_dev_password@localhost:5432/app_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Cache & State (Valkey)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Rate Limiting & Gateway
RATE_LIMIT_ENABLED=true
DOCS_UI=swagger

# Sentry Observability (Optional - leave blank to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# SMTP Email Dispatch (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_ADDRESS=noreply@platform.internal
EMAILS_FROM_NAME=Enterprise Platform
