# Stage 1: Ultra-fast dependency resolution and wheel installation via uv
FROM docker.io/library/python:{{ python_version }}-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /build
COPY pyproject.toml .
RUN uv pip install --system --no-cache --prefix=/root/.local -r pyproject.toml --extra dev

# Stage 2: Minimal non-root runtime environment
FROM docker.io/library/python:{{ python_version }}-slim AS runner

RUN useradd -u 10001 -m -s /bin/bash appuser
WORKDIR /app

COPY --from=builder /root/.local /home/appuser/.local
COPY src /app/src
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini
COPY scripts /app/scripts
COPY tests /app/tests
COPY pyproject.toml /app/pyproject.toml

# Create log directory and set permissions
RUN mkdir -p /app/logs && chown -R appuser:appuser /app

ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8

USER appuser
EXPOSE 8000

CMD [ \
    "granian", \
    "--interface",        "asgi", \
    "app.main:app", \
    "--host",             "0.0.0.0", \
    "--port",             "8000", \
    "--loop",             "uvloop", \
    "--access-log", \
    "--log-level",        "info", \
    "--workers",          "4", \
    "--runtime-threads",  "2", \
    "--http",             "auto", \
    "--backlog",          "1024", \
    "--respawn-interval", "3" \
]
