[Unit]
Description=Go High-Throughput Telemetry Ingestion Microservice
After=postgres.service valkey.service
Requires=postgres.service valkey.service

[Container]
ContainerName=platform-telemetry-ingest
Pod=platform.pod
Image=localhost/telemetry-ingest:latest
Environment=PORT=8001
Environment=DATABASE_URL=postgres://app_user:secure_dev_password@127.0.0.1:5432/app_db?sslmode=disable
Environment=VALKEY_HOST=127.0.0.1
Environment=VALKEY_PORT=6379
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target multi-user.target
