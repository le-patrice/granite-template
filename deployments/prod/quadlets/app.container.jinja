[Unit]
Description=Litestar Enterprise API - {{ project_name }}
After=postgres.service valkey.service

[Container]
ContainerName={{ project_slug }}-backend
Image=localhost/{{ project_slug }}-app:latest
PublishPort={{ app_port }}:8000
Network={{ project_slug }}.network
EnvironmentFile=/etc/{{ project_slug }}/app.env
Exec=granian --interface asgi app.main:app --host 0.0.0.0 --port 8000 --workers 4 --runtime-threads 2 --http auto --backlog 1024
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
