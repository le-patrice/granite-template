[Unit]
Description=Litestar Enterprise API Engine - {{ project_name }}
After=platform-pod.service {% if include_pgbouncer %}pgbouncer.service {% else %}postgres.service {% endif %}{% if include_valkey %}valkey.service{% endif %}
Wants=platform-pod.service

[Container]
ContainerName={{ project_slug }}-backend
Pod=platform.pod
Image=localhost/{{ project_slug }}-app:latest
EnvironmentFile=/etc/{{ project_slug }}/app.env
Exec=granian --interface asgi app.main:app --host 127.0.0.1 --port 8000 --loop uvloop --workers 4 --runtime-threads 2 --http auto --backlog 1024
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=128m
Volume=/var/log/{{ project_slug }}:/app/logs:Z
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target multi-user.target
