[Unit]
Description=Litestar Enterprise API Engine
After=pgbouncer.service valkey.service
Requires=pgbouncer.service valkey.service

[Container]
ContainerName=api-backend
Pod=platform.pod
Image=localhost/enterprise-platform:latest
EnvironmentFile=/etc/platform/app.env
Exec=granian --interface asgi app.main:app --host 127.0.0.1 --port 8000 --loop uvloop --workers 4 --runtime-threads 2 --http auto --backlog 1024
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=128m
Volume=/var/log/platform:/app/logs:Z
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target multi-user.target
