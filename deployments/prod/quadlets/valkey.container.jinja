[Unit]
Description=Valkey High-Performance In-Memory Store - {{ project_name }}
After=network-online.target local-fs.target

[Container]
ContainerName={{ project_slug }}-valkey
Image=docker.io/valkey/valkey:8-alpine
Network={{ project_slug }}.network
PublishPort=6379:6379
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
